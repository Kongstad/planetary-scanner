{
  "name": "planetary-scanner-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo && python3 ../scripts/prepare_static_demo.py --output dist/demo",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier --write src public/sol/README.md index.html vite.config.ts *.json *.md",
    "format:check": "prettier --check src public/sol/README.md index.html vite.config.ts *.json *.md"
  },
  "dependencies": {
    "cesium": "^1.145.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "prettier": "3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
